<view class="page">
  <view class="topbar"><view><view class="title">通知</view><view class="subtitle">申请审核和仓库处理提醒</view></view><text class="unread-label">{{unreadCount}} 条未读</text></view>
  <view wx:if="{{notifications.length}}">
    <view wx:for="{{notifications}}" wx:key="id" class="card notification-card {{item.is_read ? 'read' : 'unread'}}" bindtap="openNotification" data-id="{{item.id}}">
      <view class="notification-head"><view class="notification-title">{{item.title}}</view><view wx:if="{{!item.is_read}}" class="unread-dot"></view></view>
      <view class="notification-content">{{item.content}}</view>
      <view class="notification-time">{{item.createdAtText}}</view>
      <view wx:if="{{item.related_model === 'WorkflowRequest'}}" class="go-detail">查看申请详情</view>
    </view>
  </view>
  <view wx:else class="empty">暂无通知</view>
</view>
