.asset-summary { margin-bottom: 22rpx; padding: 28rpx; background: #174f3b; border-radius: 12rpx; color: #fff; }
.asset-title-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; }
.asset-name { flex: 1; font-size: 35rpx; font-weight: 700; line-height: 1.35; }
.asset-summary .tag { color: #174f3b; background: #c8f0db; }
.asset-code { margin-top: 16rpx; color: #d3eddf; font-size: 25rpx; }
.asset-type { margin-top: 10rpx; color: #d3eddf; font-size: 24rpx; }
.asset-photo { width: 100%; height: 360rpx; margin-bottom: 18rpx; border-radius: 12rpx; background: #e8ece9; }
.photo-button { margin-bottom: 22rpx; color: #176b4d; background: #e8f4ed; }
.info-row { display: flex; justify-content: space-between; gap: 30rpx; padding: 18rpx 0; border-top: 1rpx solid #eef1ef; color: #69756f; font-size: 25rpx; }
.info-row:first-of-type { border-top: 0; }
.info-row text:last-child { max-width: 58%; color: #17201c; text-align: right; word-break: break-all; }
.code-text { font-size: 23rpx; }
.action-block { margin-top: 30rpx; }
.action-gap { margin: 16rpx 0; }

.timeline { padding-top: 4rpx; }
.timeline-row { padding: 14rpx 0; border-top: 1rpx solid #eef1ef; }
.timeline-row:first-child { border-top: 0; }
.timeline-meta { color: #9aa7a0; font-size: 21rpx; }
.timeline-title { margin-top: 5rpx; color: #17201c; font-size: 25rpx; font-weight: 600; line-height: 1.4; }
.timeline-desc { margin-top: 4rpx; color: #69756f; font-size: 23rpx; line-height: 1.5; }
