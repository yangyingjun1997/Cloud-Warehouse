.login-page { min-height: 100vh; padding: 118rpx 40rpx 60rpx; background: #f7f8fa; }
.brand { display: flex; flex-direction: column; align-items: center; margin-bottom: 62rpx; }
.brand-mark { display: flex; align-items: center; justify-content: center; width: 106rpx; height: 106rpx; margin-bottom: 24rpx; color: #fff; background: #176b4d; border-radius: 18rpx; font-size: 46rpx; font-weight: 700; }
.login-title { color: #17201c; font-size: 44rpx; font-weight: 700; }
.login-subtitle, .login-tip { margin-top: 12rpx; color: #69756f; font-size: 24rpx; }
.login-card { padding: 34rpx 30rpx; background: #fff; border: 1rpx solid #e2e7e4; border-radius: 12rpx; }
.password-label { margin-top: 28rpx; }
.login-button { margin-top: 42rpx; }
.login-tip { display: block; text-align: center; }
