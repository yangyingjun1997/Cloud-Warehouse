[Unit]
Description=After-sales Warehouse return due reminders
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=warehouse
Group=warehouse
WorkingDirectory=/opt/after-sales-warehouse/backend
EnvironmentFile=/opt/after-sales-warehouse/backend/.env
ExecStart=/opt/after-sales-warehouse/venv/bin/python manage.py send_return_due_reminders
NoNewPrivileges=true
PrivateTmp=true
