[Unit]
Description=Expire pending warehouse inventory reservations
After=postgresql.service

[Service]
Type=oneshot
User=warehouse
Group=warehouse
WorkingDirectory=/opt/after-sales-warehouse/current/backend
EnvironmentFile=/srv/after-sales-warehouse/app.env
ExecStart=/opt/after-sales-warehouse/current/venv/bin/python manage.py expire_inventory_reservations

[Install]
WantedBy=multi-user.target
