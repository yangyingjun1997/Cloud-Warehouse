[Unit]
Description=After-sales Warehouse weekly low stock summary
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=warehouse
Group=warehouse
WorkingDirectory=/opt/after-sales-warehouse/backend
EnvironmentFile=/opt/after-sales-warehouse/backend/.env
ExecStart=/opt/after-sales-warehouse/venv/bin/python manage.py send_low_stock_summary
NoNewPrivileges=true
PrivateTmp=true
