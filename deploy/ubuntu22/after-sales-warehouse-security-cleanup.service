[Unit]
Description=Prune After-sales Warehouse security states
After=postgresql.service after-sales-warehouse.service

[Service]
Type=oneshot
User=warehouse
Group=warehouse
WorkingDirectory=/opt/after-sales-warehouse/backend
EnvironmentFile=/opt/after-sales-warehouse/backend/.env
ExecStart=/opt/after-sales-warehouse/venv/bin/python manage.py prune_security_states
