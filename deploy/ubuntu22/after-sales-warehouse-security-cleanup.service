[Unit]
Description=Prune After-sales Warehouse security states
After=postgresql.service after-sales-warehouse.service

[Service]
Type=oneshot
User=warehouse
Group=warehouse
WorkingDirectory=/opt/after-sales-warehouse/current/backend
EnvironmentFile=/srv/after-sales-warehouse/app.env
ExecStart=/opt/after-sales-warehouse/current/venv/bin/python manage.py prune_security_states
