[Unit]
Description=Periodic Cloudflare Tunnel health self-heal for 售后仓库
Documentation=https://developers.cloudflare.com/cloudflare-one/connections/connect-apps

[Timer]
# 每 5 分钟检查一次。断连后最多 5 分钟自动恢复，
# 同时不会因为一次瞬时抖动就频繁重启。
OnBootSec=3min
OnUnitActiveSec=5min
AccuracySec=30s

[Install]
WantedBy=timers.target
