# 统一换行符：文本文件入库一律 LF，Windows 检出按 git 配置
* text=auto eol=lf

# Windows 批处理必须 CRLF，否则双击运行可能出错
*.bat text eol=crlf
*.cmd text eol=crlf

# Linux 脚本必须 LF
*.sh text eol=lf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.xlsx binary
*.zip binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
