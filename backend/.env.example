# ── 本地开发示例配置 ────────────────────────────────────────────────────
#
# ⚠️ 这个文件只用于本机开发。手工部署时直接复制成 .env 会造成公网误配置：
#     DEBUG=1 会暴露堆栈与 SQL；ALLOWED_HOSTS=* 与 CORS_ALLOW_ALL_ORIGINS=1
#     会让任意域名访问并跨域调用 API。
#    生产部署请以 deploy/ubuntu22/ 生成的 /srv/after-sales-warehouse/app.env 为准，
#    或复制下面的「生产基线」段落并逐项填写。
#
# settings.py 会对占位 SECRET_KEY 抛 ImproperlyConfigured，
# 但 DEBUG / ALLOWED_HOSTS / CORS 没有硬保护，必须人工确认。

# ── 本地开发 ────────────────────────────────────────────────────────────
DEBUG=1
SECRET_KEY=django-insecure-local-development-only
# 开发机常用回环与内网地址；不要加 *，需要临时放开时用具体 IP
ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0,192.168.1.10
TIME_ZONE=Asia/Shanghai
DB_ENGINE=django.db.backends.sqlite3
# Windows SQLite 默认保存到 %LOCALAPPDATA%\AfterSalesWarehouse\data；生产环境填写 PostgreSQL 数据库名。
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
SQLITE_TIMEOUT_SECONDS=30
MEDIA_ROOT=media
STATIC_ROOT=staticfiles
# 仅当确有跨域前端（如独立 H5）时才开；默认关闭，按需列出具体源
CORS_ALLOW_ALL_ORIGINS=0
USE_HTTPS=0
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=0
DINGTALK_WEBHOOK=
DINGTALK_SECRET=
DINGTALK_TIMEOUT_SECONDS=5
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_AGENT_ID=
RESERVATION_EXPIRY_HOURS=72
CONSISTENCY_STATE_FILE=data/consistency-check.state.json
LOGIN_RATE_LIMIT_FAILURES=5
LOGIN_RATE_LIMIT_IP_FAILURES=20
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_LOCKOUT_SECONDS=900
API_RATE_LIMIT_IP_REQUESTS=30
API_RATE_LIMIT_ACCOUNT_REQUESTS=10
API_RATE_LIMIT_WINDOW_SECONDS=60
API_TOKEN_TTL_SECONDS=2592000
SECURITY_STATE_RETENTION_SECONDS=7776000
PRIVILEGED_MAX_ACTIVE_SESSIONS=2
ACCOUNT_SESSION_SYNC_SECONDS=300

# ── 生产基线（复制到服务器 /srv/after-sales-warehouse/app.env 后逐项填写）──
# debug=0
# secret_key=<至少 50 位随机字符串，用 python -c "import secrets;print(secrets.token_urlsafe(64))" 生成>
# allowed_hosts=<服务器内网IP>,<对外域名>      ← 不要写 *
# db_engine=django.db.backends.postgresql
# db_name=<库名>
# db_user=<专用低权限账号，不要用 postgres>
# db_password=<强口令>
# db_host=127.0.0.1
# db_port=5432
# cors_allow_all_origins=0                     ← 生产保持关闭
# use_https=0                                   ← Cloudflare 终止 TLS，源站走 HTTP
# 其余限流参数可沿用默认值
